---
import '../styles/base.css'
import Sidebar from '../components/Sidebar.astro'
import RepoLink from '../components/RepoLink.astro'
import {endpoints, ValorantEndpoint} from '@prometheuzz/valorant-api-types'
//@ts-ignore
import markedPlainText from 'marked-plaintext'
import {marked} from 'marked'
import Analytics from '@vercel/analytics/astro'

export interface Props {
	title: string
	endpointName?: string
}

const {title, endpointName} = Astro.props

let endpoint: ValorantEndpoint | undefined
for(const endpointTest of Object.values(endpoints)) {
	if(endpointTest.name === endpointName) {
		endpoint = endpointTest
		break
	}
}

let desc = 'A site dedicated to documenting the Valorant API endpoints the Valorant client uses internally'
if(endpoint) {
	const renderer = new markedPlainText()
	desc = `Valorant API endpoint ${endpoint.name} - ${marked.parseInline(endpoint.description, {renderer})}`
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const isHome = Astro.url.pathname === '/'
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark light"/>
		<meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)"/>
		<meta name="theme-color" content="#faf9f5" media="(prefers-color-scheme: light)"/>
		<link rel="canonical" href={canonicalURL}/>
		<meta property="og:type" content="website"/>
		<meta property="og:site_name" content="Valorant API Docs"/>
		<meta property="og:title" content={endpoint ? `${endpoint.method ?? 'GET'} ${endpoint.name}` : title}/>
		<meta property="og:description" content={desc}/>
		<meta property="og:url" content={canonicalURL}/>
		<meta name="twitter:card" content="summary"/>
		<link rel="icon" type="image/ico" href="/favicon.ico" />
		<meta name="description" content={desc}/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
		<title>{title}</title>
		<Analytics />
	</head>
	<body>
		<input type="checkbox" id="toggler" class="sr-only" aria-hidden="true" tabindex="-1"/>
		<header class="topbar">
			<div class="topbar-inner">
				<a href="/" class="brand" aria-label="Valorant API Docs home">
					<img class="brand-mark" src="/logo.png" width="34" height="34" alt="" aria-hidden="true"/>
					<span class="brand-text">
						<span class="brand-name">Valorant API</span>
						<span class="brand-sub">Unofficial docs</span>
					</span>
				</a>

				<label class="search" for="sidebar-search">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
					<span class="sr-only">Search endpoints</span>
					<input id="sidebar-search" type="search" placeholder="Search endpoints…" title="Search by name, URL, internal name or description" autocomplete="off" spellcheck="false" aria-keyshortcuts="/ Control+K"/>
					<button type="button" id="search-clear" aria-label="Clear search">✕</button>
					<kbd id="search-kbd" title="Press / or Ctrl+K to search">Ctrl K</kbd>
				</label>

				<nav aria-label="Primary" class="topnav">
					<a href="/" class={'ghost topnav-link' + (isHome ? ' topnav-link--active' : '')}>Guide</a>
					<a href="/endpoint/contracts" class={'ghost topnav-link' + (endpointName !== undefined ? ' topnav-link--active' : '')}>API Reference</a>
					<a href="/openapi.json" class="ghost topnav-link">OpenAPI</a>
					<span class="topnav-sep" aria-hidden="true"></span>
					<RepoLink user="PrometheuzzZ" repo="valorant-api-docs"/>
					<label for="toggler" class="ghost menu-btn" aria-controls="sidebar">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
						Menu
					</label>
				</nav>
			</div>
		</header>
		<div class="shell">
			<Sidebar endpointName={endpointName}/>
			<slot/>
		</div>
	</body>
</html>
<style is:global>
	:root {
		--bg: #0d0d0d;
		--surface: #121212;
		--surface-2: #141414;
		--surface-3: #181818;
		--code-bg: #101010;
		--hover: #161616;
		--hover-2: #1c1c1c;
		--border: #1f1f1f;
		--border-2: #262626;
		--line: #171717;
		--heading: #ffffff;
		--text: #d7d7d7;
		--text-2: #afafaf;
		--text-3: #9b9b9b;
		--muted: #8f8f8f;
		--accent: #ff9900;
		--accent-hover: #ffc163;
		--accent-ink: #0d0d0d;
		--accent-soft: rgba(255,153,0,0.1);
		--accent-line: rgba(255,153,0,0.25);
		--accent-glow: rgba(255,153,0,0.2);
		--danger: #ff7a7a;
		--success: #5fd38d;
		--warning: #ffb454;
		--method-get: #8ab4ff;
		--method-post: #5fd38d;
		--method-put: #ffb454;
		--method-delete: #ff7a7a;
		--method-wss: #c9a2ff;
		--method-tcp: #7fd6d0;
		--type-string: #ffb454;
		--type-number: #8ab4ff;
		--type-object: #7fd6d0;
		--type-bool: #c9a2ff;
		--tok-key: #ffb454;
		--tok-str: #b8e0a4;
		--tok-num: #8ab4ff;
		--tok-punct: #7a7a7a;
		--tok-comment: #808080;
		--tok-field: #e8e8e8;
		--tok-code: #cfcfcf;
		--shadow: 0 30px 60px -30px rgba(0,0,0,0.8);
		--mono: 'JetBrains Mono', ui-monospace, monospace;
		--sans: 'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif;
		--topbar-h: 71px;
		color-scheme: dark;
	}
	@media (prefers-color-scheme: light) {
		:root {
			--bg: #faf9f5;
			--surface: #ffffff;
			--surface-2: #f4f3ee;
			--surface-3: #efeee8;
			--code-bg: #ffffff;
			--hover: #f0efe9;
			--hover-2: #e9e7df;
			--border: #e6e4dc;
			--border-2: #dcd9cf;
			--line: #ecebe4;
			--heading: #121212;
			--text: #26262a;
			--text-2: #4a4a50;
			--text-3: #5f5f66;
			--muted: #6e6e75;
			--accent: #c96f00;
			--accent-hover: #a85d00;
			--accent-ink: #ffffff;
			--accent-soft: rgba(201,111,0,0.09);
			--accent-line: rgba(201,111,0,0.3);
			--accent-glow: rgba(201,111,0,0.14);
			--danger: #c62828;
			--success: #1e8e4e;
			--warning: #a65f00;
			--method-get: #2f62c9;
			--method-post: #1e8e4e;
			--method-put: #a65f00;
			--method-delete: #c62828;
			--method-wss: #7b4bd1;
			--method-tcp: #137a73;
			--type-string: #a65f00;
			--type-number: #2f62c9;
			--type-object: #137a73;
			--type-bool: #7b4bd1;
			--tok-key: #b35c00;
			--tok-str: #2e7d32;
			--tok-num: #2f62c9;
			--tok-punct: #8a8a8a;
			--tok-comment: #8a8a8a;
			--tok-field: #26262a;
			--tok-code: #3a3a40;
			--shadow: 0 24px 48px -32px rgba(0,0,0,0.25);
			color-scheme: light;
		}
	}
	html {
		font-family: var(--sans);
		background-color: var(--bg);
		color: var(--text);
		letter-spacing: -0.01em;
		scroll-padding-top: calc(var(--topbar-h) + 16px);
	}
	body {
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--text);
	}
	* { scrollbar-width: thin; scrollbar-color: var(--border-2) transparent; }
	code, pre, kbd { font-family: var(--mono); }
	button { font-family: inherit; cursor: pointer; }
	*:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 8px; }
	a.link { color: var(--accent); text-decoration: none; }
	a.link:hover { color: var(--accent-hover); text-decoration: underline; }
	.ghost { transition: background .15s, color .15s; }
	.ghost:hover { background: var(--hover-2); color: var(--heading); }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
	.hidden { display: none !important; }

	/* Syntax colours for the snippets and JSON rendered by lib/playground.ts */
	.code { font-family: var(--mono); font-size: 12.5px; line-height: 1.8; color: var(--tok-code); white-space: pre; margin: 0; tab-size: 2; }
	.code--wrap { white-space: pre-wrap; word-break: break-word; }
	.tk { color: var(--tok-key); }
	.ts { color: var(--tok-str); }
	.tn { color: var(--tok-num); }
	.tp { color: var(--tok-punct); }
	.tc { color: var(--tok-comment); font-style: italic; }
	.tf { color: var(--tok-field); }
	.tv { color: var(--accent); }

	.topbar {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	.topbar-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 28px;
		padding: 14px 28px;
		max-width: 1680px;
		margin: 0 auto;
	}
	.brand { display: flex; align-items: center; gap: 12px; color: var(--heading); text-decoration: none; }
	.brand-mark { display: block; flex: none; width: 34px; height: 34px; border-radius: 10px; object-fit: contain; }
	/* The logo is white; make it dark on the light theme */
	@media (prefers-color-scheme: light) { .brand-mark { filter: invert(1); } }
	.brand-text { display: flex; flex-direction: column; gap: 2px; }
	.brand-name { font-size: 16px; font-weight: 800; letter-spacing: -0.02em; }
	.brand-sub { font-size: 10px; font-weight: 600; letter-spacing: 0.14em; color: var(--muted); text-transform: uppercase; }

	.search {
		position: relative;
		flex: 1 1 280px;
		max-width: 460px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 10px;
		height: 42px;
		padding: 0 8px 0 14px;
		background: var(--surface-2);
		border: 1px solid var(--border);
		border-radius: 12px;
		color: var(--muted);
		transition: border-color .15s, box-shadow .15s;
	}
	.search:focus-within { border-color: var(--accent-line); box-shadow: 0 0 0 4px var(--accent-soft); }
	#sidebar-search {
		flex: 1; min-width: 0;
		background: transparent; border: 0; outline: none;
		color: var(--heading); font-family: inherit; font-size: 13px; font-weight: 500;
	}
	#sidebar-search::placeholder { color: var(--muted); }
	#sidebar-search::-webkit-search-cancel-button { display: none; }
	#search-kbd {
		font-size: 11px; color: var(--text-3);
		border: 1px solid var(--border-2); background: var(--surface-3);
		border-radius: 6px; padding: 3px 7px; white-space: nowrap;
	}
	#search-clear {
		display: none;
		background: none; border: 0; color: var(--muted);
		font-size: 11px; padding: 4px 6px; border-radius: 6px;
	}
	#search-clear:hover { color: var(--heading); background: var(--hover-2); }

	.topnav { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
	.topnav-link { padding: 10px 14px; border-radius: 10px; font-size: 13px; font-weight: 600; color: var(--text-2); text-decoration: none; }
	.topnav-link--active { color: var(--heading); background: var(--hover); }
	.topnav-sep { width: 1px; height: 22px; background: var(--border-2); margin: 0 8px; }
	.menu-btn {
		display: none; align-items: center; gap: 8px;
		height: 40px; padding: 0 12px; border-radius: 10px;
		border: 1px solid var(--border-2);
		font-size: 13px; font-weight: 600; color: var(--text); cursor: pointer;
	}

	.shell {
		display: flex;
		align-items: flex-start;
		width: 100%;
		max-width: 1680px;
		margin: 0 auto;
	}
	.shell > main { flex: 1 1 0; min-width: 0; }

	@media (max-width: 900px) {
		.topbar { position: static; }
		.topbar-inner { padding: 12px 16px; gap: 12px; }
		.search { order: 3; flex-basis: 100%; max-width: none; }
		.topnav { margin-left: auto; }
		.topnav-link, .topnav-sep { display: none; }
		.menu-btn { display: inline-flex; }
		#search-kbd { display: none; }
		.shell { flex-direction: column; align-items: stretch; }
		html { scroll-padding-top: 16px; }
	}
</style>
