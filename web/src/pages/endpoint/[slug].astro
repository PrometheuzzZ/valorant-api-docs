---
import {endpoints, type AugmentedValorantEndpoint} from '../../types/AugmentedValorantEndpoint'
import Layout from '../../layouts/Layout.astro'
import {marked} from 'marked'
import EndpointMethod from '../../components/EndpointMethod.astro'
import {createTypeAlias, printNode, zodToTs} from 'zod-to-ts'
import {Code} from 'astro/components'
import SimpleCode from '../../components/SimpleCode.astro'
import VariableItem from '../../components/VariableItem.astro'

import Shard from '../../components/doc-fragments/Shard.astro'
import Region from '../../components/doc-fragments/Region.astro'
import Cluster from '../../components/doc-fragments/Cluster.astro'
import Port from '../../components/doc-fragments/Port.astro'
import ClientVersion from '../../components/doc-fragments/ClientVersion.astro'
import LockfilePassword from '../../components/doc-fragments/LockfilePassword.astro'
import ClientPlatform from '../../components/doc-fragments/ClientPlatform.astro'

import githubDark from '../../themes/github-dark.json'
import {join} from 'node:path'
import {readdirSync, readFileSync} from 'node:fs'
import {generateMock} from '@anatine/zod-mock'
import {endpointToURL, getSlug, isHttpEndpoint, toCurl} from '../../lib/request'

const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

// Faker's raw output (huge integers, mixed-case UUIDs) looks nothing like real data, so nudge it towards plausible values
function plausible(value: unknown, key: string, seed: number): unknown {
    if(Array.isArray(value)) return value.map((v, i) => plausible(v, key, seed + i))
    if(value !== null && typeof value === 'object') {
        return Object.fromEntries(Object.entries(value).map(([k, v], i) => [k, plausible(v, k, seed * 31 + i)]))
    }
    if(typeof value === 'string' && uuidPattern.test(value)) return value.toLowerCase()
    if(typeof value === 'number') {
        const rand = Math.abs(Math.sin(seed + value)) // deterministic, so rebuilds don't churn
        if(/time|millis|date|expir|version|timestamp/i.test(key)) return 1700000000000 + Math.floor(rand * 50000000000)
        if(!Number.isInteger(value)) return Math.round(rand * 1000) / 10
        return Math.floor(rand * 100)
    }
    return value
}

function hashString(str: string) {
    let hash = 0
    for(const char of str) hash = (hash * 31 + char.charCodeAt(0)) | 0
    return Math.abs(hash)
}

function safeGenerateMock(schema: any, seedKey: string): string {
    try {
        const seed = hashString(seedKey)
        const result = plausible(generateMock(schema, {seed}), '', seed)
        const json = JSON.stringify(result, null, 2)
        return json ?? '// Unable to generate example'
    } catch {
        return '// Unable to generate example for this schema'
    }
}

// Real (anonymized) responses that the types package tests its schemas against
function readSampleResponse(slug: string): string | undefined {
    try {
        // Astro builds from the web directory (see package.json and vercel.json)
        const dir = join(process.cwd(), '..', 'valorant-api-types', 'tests', 'endpoint-responses', slug)
        const file = readdirSync(dir).filter(f => f.endsWith('.json')).sort()[0]
        if(file === undefined) return undefined
        return JSON.stringify(JSON.parse(readFileSync(join(dir, file), 'utf-8')), null, 2)
    } catch {
        return undefined
    }
}

interface VariableMeta {
    name: string
    slug: string
    descriptionHtml?: string
    type?: any
}

const endpointsBySlug = new Map<string, AugmentedValorantEndpoint>()
for(const endpoint of Object.values(endpoints)) {
    endpointsBySlug.set(getSlug(endpoint.name), endpoint)
}

export function getStaticPaths() {
    const staticPaths = []
    for(const endpoint of Object.values(endpoints)) {
        staticPaths.push({
            params: {slug: endpoint.name.toLowerCase().replace(/ /g, '-')}
        })
    }
    return staticPaths
}

function variableHtmlTemplate(variable: string, slug: string) {
    return `<a href="#${slug}" class="link">${variable}</a>`
}

function replaceEndpointLinks(str: string, type: 'markdown' | 'html') {
    const endpointLinks = str.matchAll(/\[(GET|POST|PUT|PATCH|DELETE|WSS|TCP) (.+?)\]/g)
    for(const endpointLinkMatch of endpointLinks) {
        const [linkStr, method, endpointName] = endpointLinkMatch
        const endpoint = endpointsBySlug.get(getSlug(endpointName))
        if(endpoint === undefined) continue
        const link = type === 'markdown' ?
            `[${endpoint.method || 'GET'} ${endpoint.name}](${getSlug(endpoint.name)})` :
            `<a href="${getSlug(endpointName)}" class="link">${endpoint.name}</a>`
        str = str.replaceAll(linkStr, link)
    }
    return str
}

const {slug} = Astro.params
const endpoint = endpointsBySlug.get(slug!)!

const content = replaceEndpointLinks(marked.parse(endpoint.description), 'html')

// One-line summaries for variables shared by many endpoints; their full explanation is collapsed
const commonVariableHints = new Map<string, string>([
    ['shard', 'na, pbe, eu, ap or kr: depends on where the account was created'],
    ['region', 'na, latam, br, eu, ap or kr'],
    ['cluster', 'euc1, usw2, apse1 or apne1: the SGP cluster for the region'],
    ['port', 'From the Riot Client lockfile'],
    ['lockfile password', 'From the Riot Client lockfile'],
    ['client platform', 'Base64-encoded client platform JSON'],
    ['client version', 'The current Valorant client version'],
    ['entitlement token', 'From the Entitlements Token or Entitlement endpoint'],
    ['auth token', 'From the Entitlements Token endpoint or Riot auth']
])

const variablesToReplace = new Map<string, VariableMeta>([
    ['{shard}', {
        name: 'shard',
        slug: 'shard'
    }],
    ['{region}', {
        name: 'region',
        slug: 'region'
    }],
    ['{port}', {
        name: 'port',
        slug: 'port'
    }],
    ['{puuid}', {
        name: 'puuid',
        slug: 'puuid',
        descriptionHtml: 'A player\'s UUID'
    }],
    ['{party id}', {
        name: 'party id',
        slug: 'party-id',
        descriptionHtml: 'A party ID. The ID of the current party can be found from the <a href="party-player" class="link">Party Player</a> endpoint.'
    }],
    ['{cid}', {
        name: 'cid',
        slug: 'conversation-id',
        descriptionHtml: 'A chat conversation ID. The IDs of all active conversations can be found from the <a href="all-chat-info" class="link">All Chat Info</a> endpoint.'
    }],
    ['{current game match id}', {
        name: 'current game match id',
        slug: 'current-game-match-id',
        descriptionHtml: 'The match ID of the current game. The ID of the current game can be found from the <a href="current-game-player" class="link">Current Game Player</a> endpoint.'
    }],
    ['{pre-game match id}', {
        name: 'pre-game match id',
        slug: 'pre-game-match-id',
        descriptionHtml: 'The match ID of the pre-game lobby. The ID of the pre-game lobby can be found from the <a href="pre-game-player" class="link">Pre-Game Player</a> endpoint.'
    }],
    ['{agent id}', {
        name: 'agent id',
        slug: 'agent-id',
        descriptionHtml: 'An agent ID. The IDs of all agents can be found from the third-party <a href="https://dash.valorant-api.com/endpoints/agents" class="link">Agents</a> endpoint.'
    }],
    ['{lockfile password}', {
        name: 'lockfile password',
        slug: 'lockfile-password'
    }],
    ['{client platform}', {
        name: 'client platform',
        slug: 'client-platform'
    }],
    ['{client version}', {
        name: 'client version',
        slug: 'client-version'
    }],
    ['{entitlement token}', {
        name: 'entitlement token',
        slug: 'entitlement-token',
        descriptionHtml: 'Can be obtained locally with the <a class="link" href="entitlements-token">Entitlements Token</a> endpoint or remotely using Riot auth and the <a class="link" href="entitlement">Entitlement</a> endpoint'
    }],
    ['{auth token}', {
        name: 'auth token',
        slug: 'auth-token',
        descriptionHtml: 'Can be obtained locally with the <a class="link" href="entitlements-token">Entitlements Token</a> endpoint or remotely by first using the <a class="link" href="auth-cookies">Auth Cookies</a> endpoint then using the cookies with the <a class="link" href="auth-request">Auth Request</a> endpoint'
    }]])
if(endpoint.variables !== undefined) {
    for(const [name, varType] of endpoint.variables.entries()) {
        let descriptionHtml = undefined
        if(varType.description !== undefined) {
            descriptionHtml = replaceEndpointLinks(marked.parse(varType.description) as string, 'html')
        }
        variablesToReplace.set(`{${name}}`, {
            name,
            slug: getSlug(name),
            descriptionHtml,
            type: varType
        })
    }
}

const endpointUrl = endpointToURL(endpoint)
let urlHtml = endpointUrl
let urlParameters = []
for(const [variable, meta] of variablesToReplace.entries()) {
    if(!urlHtml.includes(variable)) continue
    urlHtml = urlHtml.replace(variable, variableHtmlTemplate(variable, meta.slug))
    urlParameters.push(variable)
}

// Sort by appearance in URL such that the first variable in the url is the first in the list
urlParameters = urlParameters.sort((a, b) => endpointUrl.indexOf(a) - endpointUrl.indexOf(b))

const hasQuery = endpoint.query !== undefined && endpoint.query.size > 0
if(hasQuery) {
    let queryText = '?'
    for(const [name, type] of endpoint.query!.entries()) {
        queryText += `${name}=${variableHtmlTemplate(`{${name}}`, getSlug(name))}&`
    }
    urlHtml += `${queryText.slice(0, -1)}`
}

const headerToHtml = new Map<string, string>()
if(endpoint.headers !== undefined) {
    for(const [name, value] of endpoint.headers.entries()) {
        if(variablesToReplace.has(value)) {
            const meta = variablesToReplace.get(value)!
            headerToHtml.set(name, variableHtmlTemplate(value, meta.slug))
        } else {
            headerToHtml.set(name, value)
        }   
    }
}

const otherVariables: string[] = []
if(endpoint.riotRequirements !== undefined) {
    const req = endpoint.riotRequirements
    if(req.localAuth) {
        headerToHtml.set('Authorization', `Basic {base64 encoded "riot:${variableHtmlTemplate('{lockfile password}', 'lockfile-password')}"}`)
        otherVariables.push('{lockfile password}')
    }
    if(req.clientPlatform) {
        headerToHtml.set('X-Riot-ClientPlatform', variableHtmlTemplate('{client platform}', 'client-platform'))
        otherVariables.push('{client platform}')
    }
    if(req.clientVersion) {
        headerToHtml.set('X-Riot-ClientVersion', variableHtmlTemplate('{client version}', 'client-version'))
        otherVariables.push('{client version}')
    }
    if(req.entitlement) {
        headerToHtml.set('X-Riot-Entitlements-JWT', variableHtmlTemplate('{entitlement token}', 'entitlement-token'))
        otherVariables.push('{entitlement token}')
    }
    if(req.token) {
        headerToHtml.set('Authorization', `Bearer ${variableHtmlTemplate('{auth token}', 'auth-token')}`)
        otherVariables.push('{auth token}')
    }
}

const curlCommand = isHttpEndpoint(endpoint) ? toCurl(endpoint) : undefined
const sampleResponse = endpoint.responses?.['200'] !== undefined ? readSampleResponse(slug!) : undefined

const plainUrl = endpointUrl + (hasQuery ? '?' + Array.from(endpoint.query!.keys()).map(name => `${name}={${name}}`).join('&') : '')
const typeName = endpoint.name.replace(/[^\w]/g, '')
const codeThemes = {light: 'github-light', dark: githubDark} as const

---

<Layout title={`${endpoint.name} - Valorant API Docs`} endpointName={endpoint.name}>
    <main class="ep-main">
        <header class="ep-header">
            <h1 class="ep-title">
                <EndpointMethod method={endpoint.method} class="ep-method"/>
                {endpoint.name}
            </h1>
            {endpoint.queryName !== undefined && <div class="ep-query-name">
                <span class="ep-query-name-label">Internal name</span>
                <SimpleCode>{endpoint.queryName}</SimpleCode>
                <button class="copy-btn copy-btn--inline" data-copy={endpoint.queryName} aria-label="Copy internal name">Copy</button>
            </div>}
        </header>

        <div class="ep-url-wrap">
            <code id="endpoint-url" class="ep-url" set:html={urlHtml}/>
            <button class="copy-btn copy-btn--inline ep-url-copy" data-copy={plainUrl} aria-label="Copy URL">Copy</button>
        </div>

        <div class="prose-sane ep-description" id="description">
            <Fragment set:html={content}/>
        </div>

        {headerToHtml.size > 0 && <section class="ep-section">
            <h3 class="ep-section-title">Headers</h3>
            <ul class="ep-list">
                {Array.from(headerToHtml).map(([header, value]) => {
                    return <li>
                        <SimpleCode class="ep-header-chip" set:html={`${header}: ${value}`}/>
                    </li>
                })}
            </ul>
        </section>}

        {curlCommand !== undefined && <section class="ep-section">
            <h3 class="ep-section-title">Example Request</h3>
            <div class="schema-tabs">
                <div class="tab-bar">
                    <span class="tab-btn tab-btn--active">cURL</span>
                    <button class="copy-btn" data-copy={curlCommand}>Copy</button>
                </div>
                <Code code={curlCommand} lang="shell" wrap themes={codeThemes} defaultColor={false} />
            </div>
        </section>}

        {urlParameters.length > 0 && <section class="ep-section">
            <h3 class="ep-section-title">URL Parameters</h3>
            <ul class="ep-list ep-list--vars">
                {urlParameters.map(variable => {
                    const meta = variablesToReplace.get(variable)!

                    return <VariableItem id={meta.slug} label={variable} hint={commonVariableHints.get(meta.name)}>
                        {(() => {
                            switch(meta.name) {
                                case 'shard':
                                    return <Shard/>
                                case 'region':
                                    return <Region/>
                                case 'cluster':
                                    return <Cluster/>
                                case 'port':
                                    return <Port/>
                                default:
                                    return (meta.descriptionHtml === undefined) ? null : <Fragment set:html={meta.descriptionHtml}/>
                            }
                        })()}
                    </VariableItem>
                })}
            </ul>
        </section>}

        {hasQuery && <section class="ep-section">
            <h3 class="ep-section-title">Query Parameters</h3>
            <ul class="ep-list ep-list--vars">
                {Array.from(endpoint.query!.entries()).map(([name, type]) => {
                    return <li id={getSlug(name)} class="ep-var">
                        <div>
                            <SimpleCode>{name}</SimpleCode>
                            <span class="ep-badge">{type.isOptional() ? 'optional' : 'required'}</span>
                        </div>
                        <div class="ep-var-desc" set:html={marked.parse(type.description ?? variablesToReplace.get(`{${name}}`)?.descriptionHtml ?? '')}/>
                    </li>
                })}
            </ul>
        </section>}

        {otherVariables.length > 0 && <section class="ep-section">
            <h3 class="ep-section-title">Other Variables</h3>
            <ul class="ep-list ep-list--vars">
                {otherVariables.map(variableName => {
                    const variable = variablesToReplace.get(variableName)!

                    return <VariableItem id={getSlug(variable.slug)} label={variable.name} hint={commonVariableHints.get(variable.name)}>
                        {(() => {
                            switch(variable.name) {
                                case 'client version':
                                    return <ClientVersion/>
                                case 'lockfile password':
                                    return <LockfilePassword/>
                                case 'client platform':
                                    return <ClientPlatform/>
                                default:
                                    return (variable.descriptionHtml === undefined) ? null : <Fragment set:html={variable.descriptionHtml}/>
                            }
                        })()}
                    </VariableItem>
                })}
            </ul>
        </section>}

        {endpoint.body !== undefined && <section class="ep-section">
            <h3 class="ep-section-title">Body</h3>
            <div class="schema-tabs" data-tabs>
                <div class="tab-bar">
                    <button class="tab-btn tab-btn--active" data-tab="ts">TypeScript</button>
                    <button class="tab-btn" data-tab="json">JSON Example</button>
                    <button class="copy-btn" data-copy-panel>Copy</button>
                </div>
                <div data-panel="ts">
                    <Code code={printNode(createTypeAlias(zodToTs(endpoint.body, 'Body').node, typeName + 'Body'))} lang="ts" wrap themes={codeThemes} defaultColor={false} />
                </div>
                <div data-panel="json" class="hidden">
                    <Code code={safeGenerateMock(endpoint.body, slug + ' body')} lang="json" wrap themes={codeThemes} defaultColor={false} />
                </div>
            </div>
        </section>}

        {endpoint.responses?.['200'] && <section class="ep-section">
            <h3 class="ep-section-title">Response</h3>
            <div class="schema-tabs" data-tabs>
                <div class="tab-bar">
                    <button class="tab-btn tab-btn--active" data-tab="ts">TypeScript</button>
                    <button class="tab-btn" data-tab="json">{sampleResponse !== undefined ? 'Real Response' : 'JSON Example'}</button>
                    <button class="copy-btn" data-copy-panel>Copy</button>
                </div>
                <div data-panel="ts">
                    <Code code={printNode(createTypeAlias(zodToTs(endpoint.responses['200'], 'Response').node, typeName + 'Response'))} lang="ts" wrap themes={codeThemes} defaultColor={false} />
                </div>
                <div data-panel="json" class="hidden">
                    {sampleResponse !== undefined ?
                        <p class="ep-sample-note">An anonymized response captured from the real API.</p> :
                        <p class="ep-sample-note">Generated from the schema; values are placeholders.</p>}
                    <Code code={sampleResponse ?? safeGenerateMock(endpoint.responses['200'], slug + ' response')} lang="json" wrap themes={codeThemes} defaultColor={false} />
                </div>
            </div>
        </section>}
    </main>
</Layout>

<script>
    // Scroll to the bottom of the element instead of the top (prevents obscuring the url when the to-be-scrolled-to element is at the top of the page)
    document.querySelectorAll('a[href^="#"]').forEach(b => b.addEventListener('click', e => {
        const target = document.getElementById(b.getAttribute('href')!.slice(1))
        if(target) {
            target.querySelector('details')?.setAttribute('open', '')
            e.preventDefault()
            history.pushState({}, '', b.getAttribute('href')!)

            // From https://github.com/whatwg/html/issues/639#issuecomment-285452237
            // go back and then come forward again immediately, to force :target to update.
            history.back()
            const onpopstate = window.onpopstate
            window.onpopstate = function() {
                history.forward()
                window.onpopstate = onpopstate
            }

            target.scrollIntoView({block: 'nearest'})
        }
    }))

    if(location.hash) {
        document.getElementById(decodeURIComponent(location.hash.slice(1)))?.querySelector('details')?.setAttribute('open', '')
    }

    document.querySelectorAll<HTMLButtonElement>('[data-copy], [data-copy-panel]').forEach(btn => {
        btn.addEventListener('click', async () => {
            try {
                let text = btn.dataset.copy
                if(text === undefined) {
                    // Copy the code of whichever tab is showing
                    const panel = Array.from(btn.closest('[data-tabs]')!.querySelectorAll<HTMLElement>('[data-panel]')).find(p => !p.classList.contains('hidden'))
                    text = panel?.querySelector('pre')?.innerText ?? ''
                }
                await navigator.clipboard.writeText(text)
                btn.textContent = 'Copied'
            } catch {
                btn.textContent = 'Copy failed'
            }
            setTimeout(() => btn.textContent = 'Copy', 1500)
        })
    })

    document.querySelectorAll('[data-tabs]').forEach(tabs => {
        tabs.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const target = (btn as HTMLElement).dataset.tab!
                tabs.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('tab-btn--active'))
                btn.classList.add('tab-btn--active')
                tabs.querySelectorAll('[data-panel]').forEach(panel => {
                    (panel as HTMLElement).classList.toggle('hidden', (panel as HTMLElement).dataset.panel !== target)
                })
            })
        })
    })
</script>

<style>
.ep-main {
    padding: 40px 56px;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
}

.ep-header {
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
}

.ep-title {
    font-size: 36px;
    font-family: var(--display);
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    letter-spacing: -0.5px;
    color: var(--text);
}

:global(.ep-method) {
    font-size: 16px !important;
    font-family: var(--mono);
    font-weight: 700;
}

.ep-url {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    padding: 14px 18px;
    font-size: 14px;
    word-break: break-all;
    color: var(--text-2);
    margin-bottom: 28px;
}

:global(.ep-url a) {
    color: var(--accent);
    text-decoration: none;
}
:global(.ep-url a:hover) { text-decoration: underline; }

.ep-description {
    margin-bottom: 32px;
    font-family: var(--sans);
    font-size: 17px;
    color: var(--text-2);
    line-height: 1.7;
}

.ep-section {
    margin-top: 32px;
}

.ep-section-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-4);
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
}

.ep-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.ep-list--vars {
    gap: 14px;
}

:global(.ep-var) {
    border-left: 2px solid var(--border);
    padding-left: 14px;
    transition: border-color .15s;
}

:global(.ep-var:target) {
    border-left-color: var(--accent);
}

:global(.ep-var-desc) {
    font-family: var(--sans);
    font-size: 15.5px;
    color: var(--text-3);
    margin-top: 6px;
    line-height: 1.7;
}

:global(.ep-var-desc a) { color: var(--accent); }

.ep-badge {
    display: inline-block;
    margin-left: 8px;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid var(--border);
    color: var(--muted);
    vertical-align: middle;
}

:global(.astro-code) {
    padding: 16px 18px !important;
    border-radius: 0 0 6px 6px !important;
    border: 1px solid var(--border) !important;
    border-top: none !important;
    font-size: 13px !important;
}

.schema-tabs {
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
}

.tab-bar {
    display: flex;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
}

.tab-btn {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 8px 16px;
    background: transparent;
    border: none;
    color: var(--muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: all .15s;
}

.tab-btn:hover { color: var(--text); }

.tab-btn--active {
    color: var(--accent);
    border-bottom-color: var(--accent);
}

.ep-query-name {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    font-size: 13px;
}

.ep-query-name-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--muted);
}

.ep-url-wrap {
    position: relative;
    margin-bottom: 28px;
}

.ep-url-wrap .ep-url {
    margin-bottom: 0;
    padding-right: 76px;
}

.ep-url-copy {
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
}

:global(.ep-header-chip) {
    word-break: normal !important;
    overflow-wrap: anywhere;
}

.ep-sample-note {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--text-4);
    padding: 10px 18px 0;
    background: var(--surface);
}

/* Shiki renders both themes as CSS variables; pick one per colour scheme */
:global(.astro-code),
:global(.astro-code span) {
    color: var(--shiki-dark) !important;
