---
import {Code} from 'astro/components'
import SimpleCode from "../SimpleCode.astro";

import githubDark from '../../themes/github-dark.json'
import {defaultClientPlatform} from '../../lib/playground'

const examplePlatform = `{
    "platformType": "PC",
    "platformOS": "Windows",
    "platformOSVersion": "10.0.26200.1.256.64bit",
    "platformChipset": "Unknown"
}`

---

<p>
    A string representing the platform of the client. Base-64 encoded JSON with the following fields:
    <Code code={examplePlatform} lang="json" wrap theme={githubDark}/>
    <SimpleCode>{defaultClientPlatform}</SimpleCode>
    is a value that works.
</p>