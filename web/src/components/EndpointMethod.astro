---
import type { AugmentedValorantEndpoint } from '../types/AugmentedValorantEndpoint'

export interface Props {
    method: AugmentedValorantEndpoint['method']
    class?: string
}

function getMethodStyle(method: AugmentedValorantEndpoint['method']): string {
   switch(method) {
      case undefined:
      case 'GET':    return 'color:var(--method-get)'
      case 'POST':   return 'color:var(--method-post)'
      case 'PUT':    return 'color:var(--method-put)'
      case 'DELETE': return 'color:var(--method-delete)'
      case 'WSS':    return 'color:var(--method-wss)'
      case 'TCP':    return 'color:var(--method-tcp)'
      default:       return 'color:var(--text-4)'
   }
}

const {method} = Astro.props
const classText = Astro.props.class
---
<span style={getMethodStyle(method)} class={'font-semibold mr-1 text-xs ' + (classText ?? '')}>{method || 'GET'}</span>
