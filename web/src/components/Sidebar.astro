---
import {endpoints} from '../types/AugmentedValorantEndpoint'
import EndpointMethod from './EndpointMethod.astro'
import {type AugmentedValorantEndpoint} from '../types/AugmentedValorantEndpoint'
import {endpointToURL, getCategoryLabel, getSlug} from '../lib/request'


const categories = new Map<string, AugmentedValorantEndpoint[]>()
for(const endpoint of Object.values(endpoints)) {
    const categoryName = getCategoryLabel(endpoint as AugmentedValorantEndpoint)
    if(!categories.has(categoryName)) {
        categories.set(categoryName, [])
    }
    categories.get(categoryName)!.push(endpoint as AugmentedValorantEndpoint)
}

function getEndpointSlug(endpoint: AugmentedValorantEndpoint) {
   return '/endpoint/' + getSlug(endpoint.name)
}

// Everything a search should match: the name, method, URL, internal name, category and description
function searchText(endpoint: AugmentedValorantEndpoint, category: string) {
   const description = endpoint.description.replace(/[`*_\[\]()#>]/g, ' ')
   return [endpoint.method ?? 'GET', endpoint.name, endpointToURL(endpoint), endpoint.queryName ?? '', category, description]
      .join(' ').toLowerCase().replace(/\s+/g, ' ')
}

const {endpointName} = Astro.props
const isHome = Astro.url.pathname === '/'
---

<aside id="sidebar" aria-label="Endpoints">
   <div class="sidebar-head">
      <span class="sidebar-title">Endpoints</span>
      <span class="sidebar-count"><span class="live-dot"></span>{Object.keys(endpoints).length} documented</span>
   </div>

   <nav id="sidebar-list">
      <p id="search-empty">No endpoints found</p>
      <a href="/" class={'nav-row nav-row--home' + (isHome ? ' nav-row--active active-endpoint' : '')}>
         <span class="nav-home-icon" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 9-7 9 7"/><path d="M5 10v10h14V10"/></svg>
         </span>
         <span class="nm">Getting started</span>
      </a>
      {Array.from(categories).map(([category, categoryEndpoints]) => {
         const containsActive = categoryEndpoints.some(endpoint => endpoint.name === endpointName)
         return (
            <details class="nav-section" data-category={category} open={containsActive ? true : undefined} data-has-active={containsActive ? '' : undefined}>
               <summary class="nav-group ghost">
                  <span class="nav-group-name">{category}</span>
                  <span class="nav-group-meta">
                     <span class="nav-group-count">{categoryEndpoints.length}</span>
                     <svg class="nav-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </span>
               </summary>
               <ul class="nav-items">
                  {categoryEndpoints.map(endpoint => {
                     const active = endpointName === endpoint.name
                     return (
                        <li data-search={searchText(endpoint, category)}>
                           <a href={getEndpointSlug(endpoint)} class={'nav-row' + (active ? ' nav-row--active active-endpoint' : '')} aria-current={active ? 'page' : undefined}>
                              <EndpointMethod method={endpoint.method} badge/>
                              <span class="nm">{endpoint.name}</span>
                           </a>
                        </li>
                     )
                  })}
               </ul>
            </details>
         )
      })}
   </nav>
</aside>

<style>
aside {
   flex: 0 0 284px;
   width: 284px;
   position: sticky;
   top: var(--topbar-h);
   height: calc(100vh - var(--topbar-h));
   overflow-y: auto;
   padding: 24px 14px 48px 20px;
   border-right: 1px solid var(--line);
}

.sidebar-head {
   display: flex;
   align-items: center;
   justify-content: space-between;
   padding: 0 10px 16px;
}
.sidebar-title {
   font-size: 11px;
   font-weight: 700;
   letter-spacing: 0.12em;
   text-transform: uppercase;
   color: var(--muted);
}
.sidebar-count {
   display: flex;
   align-items: center;
   gap: 6px;
   font-size: 11px;
   font-weight: 600;
   color: var(--text-3);
}
.live-dot {
   width: 6px;
   height: 6px;
   border-radius: 50%;
   background: var(--success);
   box-shadow: 0 0 8px var(--success);
}

#sidebar-list {
   display: flex;
   flex-direction: column;
   gap: 6px;
}

.nav-section { padding-bottom: 2px; }

.nav-group {
   display: flex;
   align-items: center;
   justify-content: space-between;
   gap: 8px;
   min-height: 38px;
   padding: 0 10px;
   border-radius: 10px;
   color: var(--text-2);
   font-size: 11px;
   font-weight: 700;
   letter-spacing: 0.08em;
   text-transform: uppercase;
   cursor: pointer;
   list-style: none;
   user-select: none;
}
.nav-group::-webkit-details-marker { display: none; }
.nav-group-meta { display: flex; align-items: center; gap: 8px; flex: none; }
.nav-group-count { font-family: var(--mono); font-size: 10px; letter-spacing: 0; color: var(--muted); }
.nav-chevron { transition: transform .2s; transform: rotate(-90deg); }
.nav-section[open] .nav-chevron { transform: rotate(0deg); }

.nav-items {
   list-style: none;
   margin: 2px 0 6px;
   padding: 0;
   display: flex;
   flex-direction: column;
   gap: 1px;
}

.nav-row {
   display: flex;
   align-items: center;
   gap: 10px;
   min-height: 36px;
   padding: 0 10px;
   border-radius: 10px;
   text-decoration: none;
   transition: background .15s;
}
.nav-row:hover, .nav-row--focused { background: var(--hover); }
.nav-row:hover .nm, .nav-row--focused .nm { color: var(--heading); }
.nav-row--focused { box-shadow: inset 0 0 0 1px var(--border-2); }
.nav-row--active, .nav-row--active:hover {
   background: var(--accent-soft);
   box-shadow: inset 0 0 0 1px var(--accent-line);
}
.nav-row--active .nm { color: var(--heading); font-weight: 700; }
.nav-row--home { margin-bottom: 8px; }
.nav-home-icon {
   flex: none;
   width: 46px;
   display: flex;
   justify-content: center;
   color: var(--accent);
}

.nm {
   font-size: 13px;
   font-weight: 500;
   color: var(--text-2);
   white-space: nowrap;
   overflow: hidden;
   text-overflow: ellipsis;
}

#search-empty {
   display: none;
   margin: 0;
   padding: 12px 10px;
   font-size: 13px;
   color: var(--muted);
}

.nav-section--hidden, .nav-item--hidden { display: none; }

@media (max-width: 900px) {
   aside {
      position: static;
      width: 100%;
      flex-basis: auto;
      height: auto;
      padding: 12px 16px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      display: none;
   }
   :global(#toggler:checked ~ .shell) aside,
   aside.searching { display: block; }
}
</style>

<script>
const sidebar = document.getElementById('sidebar')!
const sections = Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-section'))
const openKey = 'sidebar-open-groups'

// Remember which groups were expanded; the group with the current endpoint is always open
function readOpenGroups(): string[] {
   try {
      return JSON.parse(localStorage.getItem(openKey) ?? '[]')
   } catch {
      return []
   }
}
const savedOpen = new Set(readOpenGroups())
for(const section of sections) {
   if(savedOpen.has(section.dataset.category!)) section.open = true
}
let restoring = false
function saveOpenGroups() {
   if(restoring || sidebar.classList.contains('searching')) return
   try {
      localStorage.setItem(openKey, JSON.stringify(sections.filter(s => s.open).map(s => s.dataset.category)))
   } catch {}
}
sections.forEach(section => section.addEventListener('toggle', saveOpenGroups))

const previousTop = sessionStorage.getItem('sidebar-scroll')
if(previousTop !== null) {
   sidebar.scrollTop = parseInt(previousTop)
} else {
   document.querySelector('#sidebar .active-endpoint')?.scrollIntoView({block: 'center'})
}

window.addEventListener('beforeunload', () => {
   sessionStorage.setItem('sidebar-scroll', sidebar.scrollTop.toString())
});

const searchInput = document.getElementById('sidebar-search') as HTMLInputElement
const searchClear = document.getElementById('search-clear') as HTMLButtonElement
const searchKbd = document.getElementById('search-kbd') as HTMLElement
const searchEmpty = document.getElementById('search-empty') as HTMLElement
const items = Array.from(document.querySelectorAll<HTMLElement>('li[data-search]'))
let focusedIndex = -1
let openBeforeSearch: boolean[] | null = null

function visibleItems() {
   return items.filter(item => !item.classList.contains('nav-item--hidden'))
}

function setFocused(index: number) {
   items.forEach(item => item.querySelector('a')!.classList.remove('nav-row--focused'))
   const visible = visibleItems()
   focusedIndex = visible.length === 0 ? -1 : (index + visible.length) % visible.length
   const link = visible[focusedIndex]?.querySelector('a')
   link?.classList.add('nav-row--focused')
   link?.scrollIntoView({block: 'nearest'})
}

function doSearch(query: string) {
   // Every word has to match somewhere, so "party code" finds "Party Join By Code"
   const terms = query.trim().toLowerCase().split(/\s+/).filter(t => t.length > 0)
   const searching = terms.length > 0
   searchClear.style.display = searching ? 'block' : 'none'
   searchKbd.style.display = searching ? 'none' : ''

   // Expand every group while searching and put them back afterwards
   if(searching && openBeforeSearch === null) openBeforeSearch = sections.map(s => s.open)
   sidebar.classList.toggle('searching', searching)

   let anyVisibleOverall = false
   sections.forEach((section, i) => {
      let anyVisible = false
      section.querySelectorAll<HTMLElement>('li[data-search]').forEach(item => {
         const match = terms.every(term => item.dataset.search!.includes(term))
         item.classList.toggle('nav-item--hidden', !match)
         if(match) anyVisible = true
      })
      section.classList.toggle('nav-section--hidden', !anyVisible)
      if(searching) section.open = true
      else if(openBeforeSearch !== null) section.open = openBeforeSearch[i]
      if(anyVisible) anyVisibleOverall = true
   })
   if(!searching && openBeforeSearch !== null) {
      restoring = true
      openBeforeSearch = null
      // toggle events fire asynchronously
      setTimeout(() => restoring = false)
   }
   searchEmpty.style.display = anyVisibleOverall ? 'none' : 'block'
   setFocused(searching ? 0 : -1)
}

function clearSearch() {
   searchInput.value = ''
   doSearch('')
}

searchInput.addEventListener('input', () => doSearch(searchInput.value))
searchInput.addEventListener('keydown', e => {
   if(e.key === 'ArrowDown') {
      e.preventDefault()
      setFocused(focusedIndex + 1)
   } else if(e.key === 'ArrowUp') {
      e.preventDefault()
      setFocused(focusedIndex - 1)
   } else if(e.key === 'Enter') {
      const link = visibleItems()[Math.max(focusedIndex, 0)]?.querySelector('a')
      if(link && searchInput.value.trim().length > 0) link.click()
   } else if(e.key === 'Escape') {
      if(searchInput.value.length > 0) clearSearch()
      else searchInput.blur()
   }
})
searchClear.addEventListener('click', e => {
   e.preventDefault()
   clearSearch()
   searchInput.focus()
})

document.addEventListener('keydown', e => {
   const target = e.target as HTMLElement
   const typing = target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)
   if((e.key === '/' && !typing) || (e.key.toLowerCase() === 'k' && (e.ctrlKey || e.metaKey))) {
      e.preventDefault()
      searchInput.focus()
      searchInput.select()
   }
})
</script>
